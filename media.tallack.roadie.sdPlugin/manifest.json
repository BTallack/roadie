{
	"Name": "Roadie for Music Assistant",
	"Version": "0.2.0.0",
	"Author": "Tallack Media",
	"Description": "Roadie puts your Music Assistant players on Stream Deck: now playing, play/pause, skip, volume, and keys that load your playlists. Talks straight to your own Music Assistant server.",
	"URL": "https://github.com/BTallack/roadie",
	"Category": "Roadie for Music Assistant",
	"CategoryIcon": "imgs/plugin/category-icon",
	"Icon": "imgs/plugin/marketplace",
	"CodePath": "bin/plugin.js",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "24",
		"Debug": "enabled"
	},
	"UUID": "media.tallack.roadie",
	"Actions": [
		{
			"Name": "Now playing",
			"UUID": "media.tallack.roadie.nowplaying",
			"Icon": "imgs/actions/nowplaying",
			"Tooltip": "Artwork, title and artist for one player. Press to play or pause. On a dial: turn for volume.",
			"PropertyInspectorPath": "ui/nowplaying.html",
			"Controllers": [
				"Keypad",
				"Encoder"
			],
			"States": [
				{
					"Image": "imgs/actions/nowplaying-key",
					"ShowTitle": false
				}
			],
			"Encoder": {
				"layout": "$B1",
				"TriggerDescription": {
					"Rotate": "Volume",
					"Push": "Play / pause",
					"Touch": "Play / pause"
				}
			}
		},
		{
			"Name": "Play / Pause",
			"UUID": "media.tallack.roadie.playpause",
			"Icon": "imgs/actions/playpause",
			"Tooltip": "Plays or pauses the player.",
			"PropertyInspectorPath": "ui/player.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/playpause-key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Next track",
			"UUID": "media.tallack.roadie.next",
			"Icon": "imgs/actions/next",
			"Tooltip": "Skips to the next track.",
			"PropertyInspectorPath": "ui/player.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/next-key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Previous track",
			"UUID": "media.tallack.roadie.previous",
			"Icon": "imgs/actions/previous",
			"Tooltip": "Goes back to the previous track.",
			"PropertyInspectorPath": "ui/player.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/previous-key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Stop",
			"UUID": "media.tallack.roadie.stop",
			"Icon": "imgs/actions/stop",
			"Tooltip": "Stops playback on the player.",
			"PropertyInspectorPath": "ui/player.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/stop-key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Volume",
			"UUID": "media.tallack.roadie.volume",
			"Icon": "imgs/actions/volume",
			"Tooltip": "Volume up, volume down, mute, or the current level as a key; on a dial, turn for volume and press to mute.",
			"PropertyInspectorPath": "ui/volume.html",
			"Controllers": [
				"Keypad",
				"Encoder"
			],
			"States": [
				{
					"Image": "imgs/actions/volume-key",
					"ShowTitle": false
				}
			],
			"Encoder": {
				"layout": "$B1",
				"TriggerDescription": {
					"Rotate": "Volume",
					"Push": "Mute / unmute",
					"Touch": "Mute / unmute"
				}
			}
		},
		{
			"Name": "Playlist",
			"UUID": "media.tallack.roadie.playlist",
			"Icon": "imgs/actions/playlist",
			"Tooltip": "Loads a playlist on a player. Shows the playlist's artwork, lit while it's playing.",
			"PropertyInspectorPath": "ui/playlist.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/playlist-key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Radio station",
			"UUID": "media.tallack.roadie.radio",
			"Icon": "imgs/actions/radio",
			"Tooltip": "Loads a radio station on a player. Shows the station's artwork, lit while it's playing.",
			"PropertyInspectorPath": "ui/radio.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/radio-key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Album",
			"UUID": "media.tallack.roadie.album",
			"Icon": "imgs/actions/album",
			"Tooltip": "Loads an album on a player. Shows its artwork, lit while it's playing.",
			"PropertyInspectorPath": "ui/album.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/album-key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Artist radio",
			"UUID": "media.tallack.roadie.artistradio",
			"Icon": "imgs/actions/artistradio",
			"Tooltip": "Starts a never-ending mix seeded by one artist.",
			"PropertyInspectorPath": "ui/artistradio.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/artistradio-key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Shuffle",
			"UUID": "media.tallack.roadie.shuffle",
			"Icon": "imgs/actions/shuffle",
			"Tooltip": "Turns shuffle on or off for the player's queue.",
			"PropertyInspectorPath": "ui/player.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/shuffle-key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Repeat",
			"UUID": "media.tallack.roadie.repeat",
			"Icon": "imgs/actions/repeat",
			"Tooltip": "Steps repeat through off, all and one for the player's queue.",
			"PropertyInspectorPath": "ui/player.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/repeat-key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Favourite",
			"UUID": "media.tallack.roadie.favourite",
			"Icon": "imgs/actions/favourite",
			"Tooltip": "A heart for what's playing: press to add it to your favourites. Needs a user with library access.",
			"PropertyInspectorPath": "ui/player.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/favourite-key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Group",
			"UUID": "media.tallack.roadie.group",
			"Icon": "imgs/actions/group",
			"Tooltip": "Joins the player to another player or group; press again to leave. Lit while grouped.",
			"PropertyInspectorPath": "ui/group.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/group-key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Move queue",
			"UUID": "media.tallack.roadie.transfer",
			"Icon": "imgs/actions/transfer",
			"Tooltip": "Moves the player's queue to another player and carries on there.",
			"PropertyInspectorPath": "ui/transfer.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/transfer-key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Select player",
			"UUID": "media.tallack.roadie.select",
			"Icon": "imgs/actions/select",
			"Tooltip": "Chooses the deck's player, for keys set to 'Selected on this deck'. On a dial: turn to step through players, press to play or pause.",
			"PropertyInspectorPath": "ui/select.html",
			"Controllers": [
				"Keypad",
				"Encoder"
			],
			"States": [
				{
					"Image": "imgs/actions/select-key",
					"ShowTitle": false
				}
			],
			"Encoder": {
				"layout": "$B1",
				"TriggerDescription": {
					"Rotate": "Choose player",
					"Push": "Play / pause",
					"Touch": "Play / pause"
				}
			}
		}
	]
}
