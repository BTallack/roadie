{
  "name": "egs-music-assistant",
  "version": "0.1.0",
  "description": "Stream Deck plugin for Music Assistant: playback controls per player, and keys that load your playlists.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart media.tallack.roadie\"",
    "test": "node --import tsx --test test/*.test.ts",
    "probe": "tsx scripts/probe.ts"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.0",
    "@elgato/utils": "^0.6.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^15.2.2",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@tsconfig/node20": "^20.1.2",
    "@types/node": "~24.1.0",
    "@types/ws": "^8.5.13",
    "rollup": "^4.0.2",
    "tslib": "^2.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.2.2",
    "ws": "^8.18.0"
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BTallack/roadie.git"
  },
  "homepage": "https://github.com/BTallack/roadie"
}
